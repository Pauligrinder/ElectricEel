[Unit]
Description=Tesla vehicle control helper (privileged BLE access for harbour-teslacontrol)
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
Type=dbus
BusName=org.teslacontrol.Helper
ExecStart=/opt/teslacontrold/bin/teslacontrold
User=teslacontrol
Group=teslacontrol
StateDirectory=teslacontrold
StateDirectoryMode=0700
Environment=TESLACONTROLD_BIN_DIR=/opt/teslacontrold/bin
Environment=TESLACONTROLD_STATE_DIR=/var/lib/teslacontrold
# Must stay false: PR_SET_NO_NEW_PRIVS would prevent the setcap'd
# tesla-control child binary from actually gaining CAP_NET_ADMIN on exec.
NoNewPrivileges=false
# authorize() in main.go reads /proc/<caller_pid>/exe to identify D-Bus
# callers. The caller (Sailjail's xdg-dbus-proxy, or a direct caller) runs
# as a different UID (defaultuser) than this service (teslacontrol), and
# reading another UID's /proc/<pid>/exe symlink is denied by the kernel
# without CAP_SYS_PTRACE, regardless of Yama ptrace_scope. Deliberately
# not restricting CapabilityBoundingSet here - it must stay unset (full
# default set) so the setcap'd tesla-control child can still pick up
# CAP_NET_ADMIN on exec; the kernel intersects a child's file capabilities
# with the parent's bounding set, so narrowing it would silently break BLE.
AmbientCapabilities=CAP_SYS_PTRACE
# No ProtectSystem=/ProtectHome=/PrivateTmp=/ProtectKernelTunables=/
# ProtectControlGroups=/RestrictNamespaces=/SystemCallFilter= here -
# deliberately, not an oversight. On-device testing against the phone's
# systemd 238 showed that declaring ANY of these (even alongside the
# explicit NoNewPrivileges=false above) makes systemd force
# PR_SET_NO_NEW_PRIVS=1 on the unit's process tree anyway - confirmed via
# /proc/<pid>/status, and NOT undoable with a `systemctl edit` drop-in that
# clears them back out (the drop-in successfully removes the resulting
# seccomp filter - Seccomp_filters: 0 - but NoNewPrivs stays 1 regardless,
# so it has to be absent from the unit's own fragment, not just
# neutralized). Since NNP is a one-way, inherited-by-children flag, that
# silently strips the setcap'd tesla-control child's ability to gain
# CAP_NET_ADMIN on exec - it fails deep inside go-ble/ble with a
# misleading "operation not permitted" that looks exactly like a missing
# setcap, even though `getcap` on the binary shows the capability is
# present and correctly applied. AmbientCapabilities=CAP_SYS_PTRACE above
# was individually verified NOT to trigger this on its own; the
# ProtectSystem=strict-family bundle above was. If re-adding any of these
# for defense in depth, re-verify NoNewPrivs stays 0 on-device first.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
