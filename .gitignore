# Build output is never committed: binaries can't be verified from source by
# reading the repo, so everything below is rebuilt from source (docs/build.md).

# Prebuilt/cross-compiled binaries (local spike and helper builds)
spike/bin/
helper/dist/

# In-app core artifacts (helper/make-app-bundle.sh stages the Rust staticlib,
# its header and the Go protocol library into the app's qmake tree)
app/thirdparty/
app/lib/
app/bin/

# Built packages - fully regenerated by the build steps in docs/build.md
app/RPMS/
*.rpm
*.tar.bz2
*.tar.gz

# Qt/qmake build output
app/build/
app/*.pro.user
app/*.pro.user.*
Makefile
Makefile.*
.qmake.stash
*.o
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_qmlcache.qrc
*.moc
/app/tests/phonekeyevents-test
/app/tests/rustruntime-test

# Rust build output
/helper/target/

# Go build output: `go build` with no -o names a binary after the module
# (electric-eel-session) or package directory; libteslable.so/.h come from
# helper/session/build-library.sh when pointed inside the tree.
/helper/session/electric-eel-session
/helper/session/teslacontrol-session
/helper/session/tesla-session
/helper/session/teslable
/helper/session/cmd/teslable/teslable
libteslable.so
libteslable.h

# Python bytecode (tools/*.py)
__pycache__/
*.py[cod]

# Local build counter: "<version> <release>"
.build-release

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
