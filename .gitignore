# Prebuilt/cross-compiled binaries - see README.md for how to rebuild them.
# Not committed: they can't be verified from source by reading the repo,
# and they get setcap'd with CAP_NET_ADMIN - build fresh from a pinned
# upstream commit instead of trusting a blob in git (see KNOWN_ISSUES.md).
spike/bin/
helper/dist/

# Build logs (environment-specific, no reuse value)
spike/*.log

# rpmbuild staging trees and built packages - fully regenerated by the
# build steps documented in README.md
helper/rpmbuild/
app/RPMS/
helper/RPMS/
*.rpm
*.tar.bz2
*.tar.gz

# Qt/qmake build output
app/build/
app/*.pro.user
app/*.pro.user.*
Makefile
Makefile.*
.qmake.stash
*.o
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_qmlcache.qrc

# Rust build output (teslacontrold)
/helper/target/
/helper/teslacontrold

# Go build output (tesla-session) - `go build .` with no -o names the
# binary after the module (teslacontrol-session)
/helper/session/teslacontrol-session
/helper/session/tesla-session

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
